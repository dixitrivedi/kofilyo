# Copy this into .streamlit/secrets.toml on your laptop, and paste the same text into
# Streamlit Cloud: your app > Settings > Secrets. Never commit the real file.

[gsheets]
# The link of the Google Sheet (or just its ID). Share the sheet with client_email below as an Editor.
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

[gsheets.service_account]
# Copy each value from the JSON key file you downloaded for your Google service account.
type = "service_account"
project_id = "your-project-id"
private_key_id = "abc123..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "kofilyo@your-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/kofilyo%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

[auth]
# The password for the login screen. Required when the app uses Google Sheets.
password = "choose-a-long-password"
